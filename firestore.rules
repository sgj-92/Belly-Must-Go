rules_version = '2';

// Belly Must Go — Firestore security rules.
//
// Everyone signs in anonymously (handled by the app). These rules keep out
// anyone who isn't using the app, block deletes of players and the group,
// and reject malformed or silly values. They do NOT stop one squad member
// from editing another's entries — the app's PIN is an honour-system lock.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optNum(v, lo, hi) { return v == null || ((v is int || v is float) && v >= lo && v <= hi); }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'stepGoal', 'startDate'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.stepGoal is int
        && request.resource.data.stepGoal >= 1000 && request.resource.data.stepGoal <= 50000
        && isDate(request.resource.data.startDate);
      allow delete: if false;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'emoji', 'targetKg', 'showWeight', 'pinHash', 'created', 'ts'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && optNum(request.resource.data.targetKg, 30, 350)
          && request.resource.data.showWeight is bool
          && (request.resource.data.pinHash == null || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() == 64))
          && isDate(request.resource.data.created);
        allow delete: if false;
      }

      match /weighins/{entryId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['pid', 'date', 'kg', 'ts'])
          && isDate(request.resource.data.date)
          && entryId == request.resource.data.pid + '_' + request.resource.data.date
          && exists(/databases/$(database)/documents/groups/$(groupId)/players/$(request.resource.data.pid))
          && (request.resource.data.kg is int || request.resource.data.kg is float)
          && request.resource.data.kg >= 30 && request.resource.data.kg <= 350;
        allow delete: if signedIn();
      }

      match /sessions/{entryId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['pid', 'date', 'text', 'ts'])
          && isDate(request.resource.data.date)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 80
          && exists(/databases/$(database)/documents/groups/$(groupId)/players/$(request.resource.data.pid));
        allow delete: if signedIn();
      }

      match /stepTotals/{entryId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['pid', 'date', 'total', 'ts'])
          && isDate(request.resource.data.date)
          && entryId == request.resource.data.pid + '_' + request.resource.data.date
          && exists(/databases/$(database)/documents/groups/$(groupId)/players/$(request.resource.data.pid))
          && request.resource.data.total is int
          && request.resource.data.total >= 0 && request.resource.data.total <= 20000000;
        allow delete: if signedIn();
      }

      match /steps/{entryId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['pid', 'date', 'steps', 'ts'])
          && isDate(request.resource.data.date)
          && entryId == request.resource.data.pid + '_' + request.resource.data.date
          && exists(/databases/$(database)/documents/groups/$(groupId)/players/$(request.resource.data.pid))
          && request.resource.data.steps is int
          && request.resource.data.steps >= 0 && request.resource.data.steps <= 150000;
        allow delete: if signedIn();
      }
    }
  }
}
